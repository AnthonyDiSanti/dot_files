{
  "shellcheck.ignorePatterns": {
    "**/*.bash": false,
    "**/*.bash_login": false,
    "**/bash_login": false,
    "**/*.bash_logout": false,
    "**/bash_logout": false,
    "**/*.bash_profile": false,
    "**/bash_profile": false,
    "**/*.bashrc": false,
    "**/bashrc": false,
    "**/*.profile": false,
    "**/profile": false,
    "**/*.sh": false,
    "**/*.shrc": false,
    "**/shrc": false,
    "**/*.zsh": true,
    "**/*.zshrc": true,
    "**/zshrc": true,
    "**/*.zprofile": true,
    "**/zprofile": true,
    "**/*.zlogin": true,
    "**/zlogin": true,
    "**/*.zlogout": true,
    "**/zlogout": true,
    "**/*.zshenv": true,
    "**/zshenv": true,
    "**/*.zsh-theme": true
  },
  "shellcheck.executablePath": "${workspaceFolder}/scripts/shellcheck-dotfiles.bash",
  "shellcheck.useWorkspaceRootAsCwd": true,
  "files.associations": {
    "**/ghostty/config": "properties"
  }
}
