#!/bin/sh

set -eu

usage() {
  cat <<'EOF'
Usage: dotfiles-clipboard copy
       dotfiles-clipboard paste
       dotfiles-clipboard status

Commands:
  copy    Reads text from stdin and writes it to the platform clipboard.
  paste   Writes platform clipboard text to stdout.
  status  Prints the detected clipboard provider.
EOF
}

die() {
  printf 'dotfiles-clipboard: %s\n' "$*" >&2
  exit 1
}

dotfiles_have_command() {
  command -v "$1" >/dev/null 2>&1
}

dotfiles_running_under_wsl() {
  if [ -n "${WSL_DISTRO_NAME:-}" ] || [ -n "${WSL_INTEROP:-}" ]; then
    return 0
  fi

  [ -r /proc/version ] || return 1
  grep -qi microsoft /proc/version || grep -qi wsl /proc/version
}

detect_provider() {
  os="$(uname -s 2>/dev/null || printf unknown)"

  if [ "$os" = Darwin ] && dotfiles_have_command pbcopy && dotfiles_have_command pbpaste; then
    printf '%s\n' macos
    return 0
  fi

  if dotfiles_running_under_wsl \
    && dotfiles_have_command clip.exe \
    && dotfiles_have_command powershell.exe; then
    printf '%s\n' wsl
    return 0
  fi

  return 1
}

require_provider() {
  provider="$(detect_provider)" || die "no supported clipboard provider found"
  printf '%s\n' "$provider"
}

copy_clipboard() {
  provider="$(require_provider)"

  case "$provider" in
    macos)
      pbcopy || die "pbcopy failed"
      ;;
    wsl)
      clip.exe || die "clip.exe failed"
      ;;
    *)
      die "unsupported provider: $provider"
      ;;
  esac
}

paste_clipboard() {
  provider="$(require_provider)"

  case "$provider" in
    macos)
      pbpaste || die "pbpaste failed"
      ;;
    wsl)
      # PowerShell variables must reach powershell.exe literally.
      # shellcheck disable=SC2016
      powershell.exe \
        -NoLogo \
        -NoProfile \
        -NonInteractive \
        -Command '$clip = Get-Clipboard -Raw; if ($null -ne $clip) { [Console]::Out.Write($clip.ToString().Replace("`r", "")) }' \
        || die "powershell.exe Get-Clipboard failed"
      ;;
    *)
      die "unsupported provider: $provider"
      ;;
  esac
}

status_clipboard() {
  provider="$(detect_provider)" || die "no supported clipboard provider found"
  printf '%s\n' "$provider"
}

if [ "$#" -ne 1 ]; then
  usage >&2
  exit 2
fi

case "$1" in
  copy)
    copy_clipboard
    ;;
  paste)
    paste_clipboard
    ;;
  status)
    status_clipboard
    ;;
  --help | -h)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
